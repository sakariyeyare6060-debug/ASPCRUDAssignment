@page
@model DeleteModel
<h2>Delete Order</h2>
<h4>Are you sure you want to delete this order?</h4>

<div>
    <p><strong>Order ID:</strong> @Model.Order.Id</p>
    <p><strong>Customer:</strong> @Model.Order.CustomerName</p>
    <p><strong>Product:</strong> @Model.Order.ProductName</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Order.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>